{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Herd",
  "version": "0.1.0",
  "identifier": "id.meowlabs.universal-herd",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ../ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Herd",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"], "externalBin": ["binaries/herd"] }
}
